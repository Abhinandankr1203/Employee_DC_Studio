Options -Indexes
RewriteEngine On

# Serve real files and directories directly (js, css, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all /api/* requests to the PHP router
RewriteRule ^api/(.*)$ api/router.php [QSA,L]

# Everything else → index.html (Single Page App)
RewriteRule ^ index.html [L]
